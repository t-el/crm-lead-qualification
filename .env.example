# ---- Server ----
PORT=8900
PUBLIC_URL=http://localhost:8900        # public https URL in production (Twilio signs requests against it)
DATA_DIR=data
LOG_FORMAT=json                         # json | pretty
BUSINESS_NAME=Atlas Heating & Cooling
BUSINESS_TZ=America/New_York            # quiet hours + booking slots use this zone
DEFAULT_CALLING_CODE=1
SERVICE_AREA_ZIPS=10001,10002,10003,10011,10014,11201,11211,11215
QUIET_HOURS_START=20                    # no follow-up texts from 20:00...
QUIET_HOURS_END=8                       # ...until 08:00 local
WEBHOOK_SECRET=                         # if set, form webhooks must send X-Webhook-Secret
BOOKING_SECRET=change-me-long-random    # signs booking links

# ---- Twilio (leave ACCOUNT_SID empty to use the mock SMS sender) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=twilio-demo-token
TWILIO_FROM_NUMBER=+15550100200
VALIDATE_TWILIO_SIGNATURE=true

# ---- Email via Resend (empty = mock) ----
RESEND_API_KEY=
EMAIL_FROM=Atlas Heating & Cooling <hello@example.com>

# ---- CRM ----
CRM_PROVIDER=hubspot                    # hubspot | gohighlevel
CRM_MOCK=true                           # false = call the real API
HUBSPOT_TOKEN=pat-mock                  # private app token: crm.objects.contacts/deals.write
HUBSPOT_PIPELINE=default
GHL_TOKEN=ghl-mock                      # private integration token (contacts, opportunities)
GHL_LOCATION_ID=loc_demo
GHL_PIPELINE_ID=pipe_demo

# ---- AI (optional: rules handle the common answers; the model handles the rest) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Reliability ----
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY_MS=500
